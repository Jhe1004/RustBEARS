    given-names: "Jian"
    email: "j.he930724@gmail.com"
  - family-names: "Matzke"
    given-names: "Nicholas J."
references:
  - type: article
    title: "Probabilistic historical biogeography: new models for founder-event speciation, imperfect detection, and fossils allow improved accuracy and model-testing"
    authors:
      - family-names: "Matzke"
        given-names: "Nicholas J."
    journal: "Frontiers of Biogeography"
    volume: 5
    issue: 4
    start: 242
    end: 248
    year: 2013
    doi: "10.21425/F5FBG19694"
  - type: article
    title: "Model Selection in Historical Biogeography Reveals that Founder-Event Speciation Is a Crucial Process in Island Clades"
    authors:
      - family-names: "Matzke"
        given-names: "Nicholas J."
    journal: "Systematic Biology"
    volume: 63
    issue: 6
    start: 951
    end: 970
    year: 2014
    doi: "10.1093/sysbio/syu056"
